#include "esp_camera.h"
#include <WiFi.h>
#include <WebServer.h>
#include "esp_http_server.h"
#include <ESP32Servo.h>

// ========================= WIFI =========================
const char* ssid = "MyWiFiCar";
const char* password = "12345678";

// ========================= CAMERA MODEL =========================
#define CAMERA_MODEL_AI_THINKER

#if defined(CAMERA_MODEL_AI_THINKER)
  #define PWDN_GPIO_NUM     32
  #define RESET_GPIO_NUM    -1
  #define XCLK_GPIO_NUM      0
  #define SIOD_GPIO_NUM     26
  #define SIOC_GPIO_NUM     27

  #define Y9_GPIO_NUM       35
  #define Y8_GPIO_NUM       34
  #define Y7_GPIO_NUM       39
  #define Y6_GPIO_NUM       36
  #define Y5_GPIO_NUM       21
  #define Y4_GPIO_NUM       19
  #define Y3_GPIO_NUM       18
  #define Y2_GPIO_NUM        5
  #define VSYNC_GPIO_NUM    25
  #define HREF_GPIO_NUM     23
  #define PCLK_GPIO_NUM     22
#endif

// ========================= MOTOR PINS =========================
#define IN1 12
#define IN2 13
#define IN3 15
#define IN4 14

// ========================= SERVO =========================
#define SERVO_PIN 2
Servo scanServo;

// ========================= ULTRASONIC =========================
#define TRIG_PIN 1   // U0T
#define ECHO_PIN 3   // U0R

// ========================= FLASH =========================
#define FLASH_LED_PIN 4

WebServer server(80);
httpd_handle_t stream_httpd = NULL;

String robotState = "STOP";
bool flashOn = false;
bool autoMode = false;

int centerPos = 90;
int leftPos   = 150;
int rightPos  = 30;
int obstacleDistance = 20;

// ========================= MOTOR FUNCTIONS =========================
void forwardRobot() {
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
  robotState = "FORWARD";
}

void backwardRobot() {
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, HIGH);
  robotState = "BACKWARD";
}

void turnLeft() {
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
  robotState = "LEFT";
}

void turnRight() {
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, HIGH);
  robotState = "RIGHT";
}

void stopRobot() {
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, LOW);
  robotState = "STOP";
}

// ========================= FLASH =========================
void setFlash(bool state) {
  flashOn = state;
  digitalWrite(FLASH_LED_PIN, flashOn ? HIGH : LOW);
}

// ========================= ULTRASONIC =========================
long getDistance() {
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(3);

  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);

  long duration = pulseIn(ECHO_PIN, HIGH, 30000);
  if (duration == 0) return 999;

  long distance = duration * 0.034 / 2;
  return distance;
}

// ========================= SERVO SCAN =========================
int scanDirection() {
  long leftDistance, rightDistance;

  scanServo.write(centerPos);
  delay(300);

  scanServo.write(leftPos);
  delay(500);
  leftDistance = getDistance();

  scanServo.write(rightPos);
  delay(500);
  rightDistance = getDistance();

  scanServo.write(centerPos);
  delay(300);

  bool leftValid = (leftDistance > 5 && leftDistance < 200);
  bool rightValid = (rightDistance > 5 && rightDistance < 200);

  if (leftValid && rightValid) {
    if (leftDistance > rightDistance) return 1;
    else return 2;
  } else if (leftValid) {
    return 1;
  } else if (rightValid) {
    return 2;
  }

  return 0;
}

// ========================= AUTO MODE =========================
void runAutoMode() {
  long frontDistance = getDistance();

  if (frontDistance > obstacleDistance) {
    forwardRobot();
  } else {
    stopRobot();
    delay(300);

    int direction = scanDirection();

    if (direction == 1) {
      turnLeft();
      delay(500);
    } else if (direction == 2) {
      turnRight();
      delay(500);
    } else {
      backwardRobot();
      delay(400);
      turnRight();
      delay(500);
    }

    stopRobot();
    delay(200);
  }
}

// ========================= CAMERA STREAM =========================
static const char* _STREAM_CONTENT_TYPE = "multipart/x-mixed-replace;boundary=frame";
static const char* _STREAM_BOUNDARY = "\r\n--frame\r\n";
static const char* _STREAM_PART = "Content-Type: image/jpeg\r\nContent-Length: %u\r\n\r\n";

static esp_err_t stream_handler(httpd_req_t *req) {
  camera_fb_t * fb = NULL;
  esp_err_t res = ESP_OK;
  char part_buf[64];

  res = httpd_resp_set_type(req, _STREAM_CONTENT_TYPE);
  if (res != ESP_OK) return res;

  while (true) {
    fb = esp_camera_fb_get();
    if (!fb) {
      res = ESP_FAIL;
    } else {
      size_t hlen = snprintf(part_buf, sizeof(part_buf), _STREAM_PART, fb->len);
      res = httpd_resp_send_chunk(req, _STREAM_BOUNDARY, strlen(_STREAM_BOUNDARY));
      if (res == ESP_OK) res = httpd_resp_send_chunk(req, part_buf, hlen);
      if (res == ESP_OK) res = httpd_resp_send_chunk(req, (const char*)fb->buf, fb->len);
      esp_camera_fb_return(fb);
    }

    if (res != ESP_OK) break;
    delay(25);
  }

  return res;
}

void startStreamServer() {
  httpd_config_t config = HTTPD_DEFAULT_CONFIG();
  config.server_port = 81;
  config.ctrl_port = 32769;

  httpd_uri_t stream_uri = {
    .uri = "/stream",
    .method = HTTP_GET,
    .handler = stream_handler,
    .user_ctx = NULL
  };

  if (httpd_start(&stream_httpd, &config) == ESP_OK) {
    httpd_register_uri_handler(stream_httpd, &stream_uri);
  }
}

